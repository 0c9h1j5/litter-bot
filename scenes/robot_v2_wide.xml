<!--
  robot_v2 (wide): 주인 설계(2026-11-24) 배치 — 메카넘 차체(단순화) + 옆솔·흡입·패드 판정 영역 + 묻힌 쓰레기통 + SO-101
  이 파일은 scripts/build_robot_v2.py 가 만든다. 손으로 고치지 말고 스크립트의 VARIANTS 값을 고친 뒤 다시 돌린다.
  - 차체 'wide': 길이 0.39 m, 폭 0.28 m(바퀴 포함), 윗면 0.15 m, 질량 4.2 kg (+ 핸디 청소기 0.7 kg)
  - 이동: robot_v1 과 같음(평면 관절 base_x/base_y/base_yaw + 속도 액추에이터, 롤러 없음)
  - 팔: so101_new_calib_litterbot.xml, 어깨 회전축 = 윗면 앞 모서리에서 0.06 m 뒤, 가운데
  - 앞: 옆솔 2개(brush_left/right) · 밑 가운데 흡입구(site suction_zone) · 뒤 패드 2개(pad_left/right) — 모두 충돌 없는 판정 영역
    범퍼(bumper)만 충돌 있음, 바닥에서 0.015 m
  - 쓰레기통(body bin, site bin_zone): 몸통에 묻음, 안쪽 0.13 × 0.13 m, 바닥 0.045 m, 테두리 0.15 m(= 윗면)
  치수·질량 중 출처가 없는 값은 모두 가정이다 (logs/2026-11-24_robot_v2_measurements.md 1절).
-->
<mujoco model="robot_v2_wide">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>
  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.35 0.35 0.35"/>
    <global offwidth="1600" offheight="1200"/>
  </visual>
  <default>
    <default class="base"><geom type="box" mass="0" rgba="0.82 0.84 0.86 1" friction="0.6 0.005 0.0001"/></default>
    <default class="upper"><geom type="box" mass="0" rgba="0.2 0.55 0.3 1" friction="0.6 0.005 0.0001"/></default>
    <default class="vis"><geom contype="0" conaffinity="0" mass="0"/></default>
    <default class="wheel"><geom type="cylinder" euler="1.5708 0 0" contype="0" conaffinity="0" mass="0" rgba="0.15 0.15 0.15 1"/></default>
    <default class="bumper"><geom type="box" mass="0.03" rgba="0.15 0.15 0.15 1" friction="0.3 0.005 0.0001"/></default>
    <default class="zone"><geom contype="0" conaffinity="0" mass="0"/></default>
    <default class="bin"><geom type="box" mass="0.01" rgba="0.95 0.95 0.95 1"/></default>
  </default>
  <asset>
    <model name="so101" file="assets/so101/so101_new_calib_litterbot.xml"/>
  </asset>
  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" diffuse="0.7 0.7 0.7"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.8 0.62 0.4 1"/>
    <body name="robot" pos="0 0 0">
      <joint name="base_x" type="slide" axis="1 0 0" damping="0"/>
      <joint name="base_y" type="slide" axis="0 1 0" damping="0"/>
      <joint name="base_yaw" type="hinge" axis="0 0 1" damping="0"/>
      <site name="robot_origin" pos="0 0 0" size="0.01"/>
      <geom name="base_0" class="base" pos="0 0 0.038" size="0.195 0.1066 0.003"/>
      <geom name="base_1" class="base" pos="-0.1482 0 0.0605" size="0.0468 0.1066 0.0195"/>
      <geom name="base_2" class="base" pos="0.1158 0 0.0605" size="0.0792 0.1066 0.0195"/>
      <geom name="base_3" class="base" pos="-0.0323 -0.0728 0.0605" size="0.069 0.0338 0.0195"/>
      <geom name="base_4" class="base" pos="-0.0323 0.1028 0.0605" size="0.069 0.0038 0.0195"/>
      <geom name="upper_5" class="upper" pos="-0.1482 0 0.115" size="0.0468 0.0916 0.035"/>
      <geom name="upper_6" class="upper" pos="0.1158 0 0.115" size="0.0792 0.0916 0.035"/>
      <geom name="upper_7" class="upper" pos="-0.0323 -0.0653 0.115" size="0.069 0.0263 0.035"/>
      <geom name="chassis_mass" class="vis" type="box" pos="0 0 0.0925" size="0.01 0.01 0.01" mass="4.2" rgba="0 0 0 0"/>
      <geom name="vacuum_mass" class="vis" type="box" pos="-0.02 -0.0533 0.0575" size="0.01 0.01 0.01" mass="0.7" rgba="0 0 0 0"/>
      <geom name="wheel_fl" class="wheel" pos="0.13 0.1248 0.0325" size="0.0325 0.0152"/>
      <geom name="wheel_fr" class="wheel" pos="0.13 -0.1248 0.0325" size="0.0325 0.0152"/>
      <geom name="wheel_rl" class="wheel" pos="-0.13 0.1248 0.0325" size="0.0325 0.0152"/>
      <geom name="wheel_rr" class="wheel" pos="-0.13 -0.1248 0.0325" size="0.0325 0.0152"/>
      <geom name="bumper" class="bumper" pos="0.201 0 0.0375" size="0.006 0.1066 0.0225"/>
      <geom name="brush_left" class="zone" type="cylinder" pos="0.177 0.0886 0.004" size="0.045 0.004" rgba="0.95 0.65 0.1 0.7"/>
      <geom name="brush_right" class="zone" type="cylinder" pos="0.177 -0.0886 0.004" size="0.045 0.004" rgba="0.95 0.65 0.1 0.7"/>
      <geom name="pad_left" class="zone" type="cylinder" pos="-0.24 0.055 0.003" size="0.055 0.003" rgba="0.12 0.44 0.36 0.6"/>
      <geom name="pad_right" class="zone" type="cylinder" pos="-0.24 -0.055 0.003" size="0.055 0.003" rgba="0.12 0.44 0.36 0.6"/>
      <site name="suction_zone" type="box" pos="0.0655 0 0.015" size="0.02 0.05 0.015" rgba="0.16 0.49 0.88 0.5"/>
      <geom name="cam_mast" class="vis" type="cylinder" pos="0.175 -0.0766 0.2" size="0.006 0.05" rgba="0.3 0.3 0.3 1"/>
      <geom name="cam_box" class="vis" type="box" pos="0.175 -0.0766 0.25" euler="0 0.6109 0" size="0.0125 0.045 0.0125" rgba="0.1 0.1 0.1 1"/>
      <camera name="depth_cam" pos="0.188 -0.0766 0.25" fovy="58" xyaxes="0 -1 0 0.5736 0 0.8192"/>
      <geom name="screen" class="vis" type="box" pos="0.197 0 0.12" size="0.002 0.05 0.02" rgba="0.05 0.1 0.2 1"/>
      <geom name="handle_bar" class="vis" type="capsule" fromto="-0.175 -0.04 0.19 -0.175 0.04 0.19" size="0.006" rgba="0.25 0.25 0.25 1"/>
      <geom name="handle_post_l" class="vis" type="capsule" fromto="-0.175 0.04 0.15 -0.175 0.04 0.19" size="0.005" rgba="0.25 0.25 0.25 1"/>
      <geom name="handle_post_r" class="vis" type="capsule" fromto="-0.175 -0.04 0.15 -0.175 -0.04 0.19" size="0.005" rgba="0.25 0.25 0.25 1"/>
      <geom name="estop" class="vis" type="cylinder" pos="-0.16 -0.0666 0.16" size="0.015 0.01" rgba="0.85 0.1 0.1 1"/>
      <geom name="cradle" class="vis" type="box" pos="0.13 -0.0616 0.162" size="0.02 0.025 0.012" rgba="0.55 0.55 0.6 1"/>
      <body name="bin" pos="-0.0323 0.03 0">
        <geom name="bin_floor" class="bin" pos="0 0 0.043" size="0.069 0.069 0.002"/>
        <geom name="bin_wall_f" class="bin" pos="0.067 0 0.0975" size="0.002 0.069 0.0525"/>
        <geom name="bin_wall_b" class="bin" pos="-0.067 0 0.0975" size="0.002 0.069 0.0525"/>
        <geom name="bin_wall_l" class="bin" pos="0 0.067 0.0975" size="0.065 0.002 0.0525"/>
        <geom name="bin_wall_r" class="bin" pos="0 -0.067 0.0975" size="0.065 0.002 0.0525"/>
        <site name="bin_zone" type="box" pos="0 0 0.0975" size="0.065 0.065 0.0525" rgba="1 1 0 0.2"/>
      </body>
      <frame name="arm_mount" pos="0.0962 0 0.15">
        <attach model="so101" body="base" prefix="arm_"/>
      </frame>
    </body>
  </worldbody>
  <actuator>
    <velocity name="drive_x" joint="base_x" kv="400" ctrlrange="-1 1"/>
    <velocity name="drive_y" joint="base_y" kv="400" ctrlrange="-1 1"/>
    <velocity name="drive_yaw" joint="base_yaw" kv="20" ctrlrange="-3.92 3.92"/>
  </actuator>
</mujoco>
